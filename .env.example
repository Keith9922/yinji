# GMI Cloud API Key
# 获取地址: https://console.gmicloud.ai
GMI_API_KEY=your_gmi_api_key_here

# FastAPI CORS，多个来源用英文逗号分隔
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# API 服务端口
API_HOST=0.0.0.0
API_PORT=8000

# Gradio demo 服务端口
GRADIO_HOST=0.0.0.0
GRADIO_PORT=7860

# rembg 轻量模型配置
REMBG_MODEL=u2netp
REMBG_MAX_SIDE=768

# 无 GMI 额度时用于本地联调
MOCK_GENERATION=0
